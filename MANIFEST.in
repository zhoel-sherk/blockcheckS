include configs/*.conf
include configs/composite_discord.conf
recursive-include presets/strategies *.tls *.txt *.http *.quic *.udp
recursive-include presets/domains *.txt
recursive-include presets/ipset *.txt
include presets/manifest.toml
include presets/README.md
include presets/blobs/README.md
recursive-include blobs *.bin
include blobs/README.md
recursive-include lua/blockchecks *.lua
recursive-include lua/custom *.lua *.toml
include lua/README.md
include lua/custom/README.md
include LICENSE
include README.md
include docs/todo.md
include docs/guide.md
include docs/package.md
include changelog.md
recursive-include systemd *.service
recursive-include src/blockchecks *.py

# Release hygiene: keep the sdist lean regardless of the build environment.
# (Tests/dev/caches/mutation artefacts are not needed by pip consumers; a VCS
# file-finder in the build env would otherwise pull them into the sdist.)
prune tests
prune dev
prune mutants
prune .hypothesis
prune .ruff_cache
prune .pytest_cache
prune logs
prune reports
prune build
prune dist
prune .venv
global-exclude __pycache__ *.py[cod]
global-exclude .coverage
global-exclude state.db-wal state.db-shm
