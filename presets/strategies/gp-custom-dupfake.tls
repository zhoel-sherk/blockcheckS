# M4 / GP Keenetic dupfake strategies — requires lua/custom/dupfake.lua on host
# (загрузка: BLOCKCHECKS_LUA_EXTRA=$PWD/lua/custom/dupfake.lua или
#  --lua-init=@.../dupfake.lua после zapret-auto.lua на Keenetic).
# Экспорт конфигов добавляет комментарий-ссылку # --lua-custom1 "...".
#
# Keenetic production (dupfake core, atomic multi-blob):
dupfake:blob=stun+max_ru:repeats=6:tcp_ts=-1000
dupfake:blob=tls_clienthello:repeats=6:tcp_ts=-1000
#
# BS fallback (multi-line, same blobs) — работает БЕЗ кастомного lua:
fake:blob=stun:repeats=6:tcp_ts=-1000
fake:blob=max_ru:repeats=6:tcp_ts=-1000
fake:blob=stun:repeats=6:tcp_ts=-1000
fake:blob=google:repeats=6:tcp_ts=-1000
