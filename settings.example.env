# blockcheckS environment (copy to shell or .env)
# See CONTRIBUTING.md. Full env surface: engine/config.py + engine/settings.py.

# Core paths
BLOCKCHECKS_NFQWS2=/opt/zapret2/nfq2/nfqws2
BLOCKCHECKS_BLOBS=/opt/zapret2/blobs
# ZAPRET2_ROOT=/opt/zapret2
# BLOCKCHECKS_LUA_DIR=/opt/zapret2/lua

# Optional — defaults: .venv/bin/python, sys.executable
# BLOCKCHECKS_PYTHON=

# Optional — settings.toml path (engine/settings); Discord token lives there
# BLOCKCHECKS_SETTINGS=/path/to/settings.toml

# Optional — yt-dlp path for googlevideo URL fetch (GV-1)
# BLOCKCHECKS_YTDLP=/path/to/yt-dlp

# Optional — sing-box SOCKS5 for auto-discover
# BLOCKCHECKS_PROXY=socks5://127.0.0.1:11080

# Secure DNS (default on) + DoH endpoint override
# BLOCKCHECKS_SECURE_DNS=1
# BLOCKCHECKS_DOH_SERVER=https://cloudflare-dns.com/dns-query
# BLOCKCHECKS_DNS_CACHE_TTL=3600

# Probes / campaigns
# BLOCKCHECKS_POOL=4
# BLOCKCHECKS_CURL_PARALLEL=1
# BLOCKCHECKS_WALL_SLACK=3.0
# BLOCKCHECKS_QNUM_TCP=200
# BLOCKCHECKS_QNUM_UDP=201
# Host-mode (canon docs/hostmode.md; --probe-isol=host on bs tcp / composite).
# BLOCKCHECKS_HOST_QNUM_TCP=220
# UDP host slots take odd qnums (221+2i); voice attaches WITHOUT bypass.
# BLOCKCHECKS_HOST_QNUM_UDP=221
# PROBE mark for nft "meta mark set" + nfqws2 --filter-mark (binary >= 1.0.5,
# deployed 2026-09-09). Must not overlap BLOCKCHECKS_DESYNC_MARK (hard guard).
# Set 0 to disable both the nft mark-set rule and the conf injection.
# BLOCKCHECKS_PROBE_MARK=0x20000000
# BLOCKCHECKS_PROBE_ISOL=netns
# Host slot count for campaigns (scan/pair/full --probe-isol=host):
# int = fixed override; auto = resource formula (cpu-1, 60% MemAvailable /
# 220MiB per slot, cap 16). Not the netns --parallel knob.
# BLOCKCHECKS_HOST_SLOTS=auto

# BLOCKCHECKS_UNBLOCKED_DOM=ripe.net
# BLOCKCHECKS_UNBLOCKED_DOMS=ripe.net,cloudflare.com,about.rdap.org,iana.org

# Debug / experiment presets
# BLOCKCHECKS_GGC_MODE=synthetic|real|fixed
# BLOCKCHECKS_IMPERSONATE=chrome124
# BLOCKCHECKS_LOG_LEVEL=INFO
# BLOCKCHECKS_NFQWS2_DEBUG=0
