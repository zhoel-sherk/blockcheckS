# blockcheckS environment (copy to shell or .env)
# See CONTRIBUTING.md

BLOCKCHECKS_NFQWS2=/opt/zapret2/nfq2/nfqws2
BLOCKCHECKS_BLOBS=/opt/zapret2/blobs

# Optional — defaults: .venv/bin/python, sys.executable
# BLOCKCHECKS_PYTHON=

# Optional — Discord token for --auto-discover (voice_discovery)
# BLOCKCHECKS_SETTINGS=/path/to/settings.ini

# Optional — yt-dlp path for googlevideo URL fetch (GV-1)
# BLOCKCHECKS_YTDLP=/path/to/yt-dlp

# Optional — sing-box SOCKS5 for auto-discover
# BLOCKCHECKS_PROXY=socks5://127.0.0.1:11080

# Secure DNS (Phase 9) — default on
# BLOCKCHECKS_SECURE_DNS=1
# BLOCKCHECKS_DOH_SERVER=https://cloudflare-dns.com/dns-query
# BLOCKCHECKS_DNS_CACHE_TTL=3600
